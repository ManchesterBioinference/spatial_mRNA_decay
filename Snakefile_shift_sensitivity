"""
Snakemake sensitivity pipeline: stripe AP window shift analysis.

Tests whether shifting the stripe AP coordinate window by ±half a bin width
changes the inferred degradation rates.  This validates that any residual
mis-alignment between Berrocal transcription data and smFISH (mRNA) imaging
data does not introduce bias into the inferred degradation rates.

Shift directions
----------------
  shiftLeft  → AP window translated toward lower AP (anterior) by half a bin
  shiftRight → AP window translated toward higher AP (posterior) by half a bin

Shift amount (per stripe, computed at runtime)
----------------------------------------------
  shift = (max − min) / (2 × n_ap_bins)

  Example — stripe2 with n_ap_bins=5, width=0.09:
    shift = 0.009 AP units
    shiftRight: min 0.3525→0.3615, center 0.3975→0.4065, max 0.4425→0.4515
    shiftLeft:  min 0.3525→0.3435, center 0.3975→0.3885, max 0.4425→0.4335

Output layout
-------------
  shiftLeft/results_{max_time}/{stripe}/{embryo}/...
  shiftRight/results_{max_time}/{stripe}/{embryo}/...

Dependency on main Snakefile
-----------------------------
This pipeline does NOT re-run stripe identification or raw data acquisition.
It requires that the main Snakefile has already produced:
  results_{max_time}/config.yaml           (populated with stripe_ranges)
  results_{max_time}/config.yaml.updated   (stripe identification complete)

  data/Berrocal_2020/Data/eve_data_longform_w_nuclei_060520_FILTERED.csv
  data/Ali_embryos/{stripe}/{embryo}/time_data/position_data.txt

Usage
-----
  # Dry-run (check DAG)
  snakemake --snakefile Snakefile_shift_sensitivity --cores 1 --dry-run

  # Full run (after main pipeline has completed stripe identification)
  snakemake --snakefile Snakefile_shift_sensitivity --cores 4

  # On SLURM
  sbatch slurm.sh --snakefile Snakefile_shift_sensitivity
"""

import os

# ── Configuration (mirrors main Snakefile) ─────────────────────────────────────
configfile: "config.yaml"

STRIPES        = config.get("stripes",   ["stripe2"])
EMBRYOS        = config.get("embryos",   {})
N_AP_BINS      = config.get("n_ap_bins", 5)
N_DV_BINS      = config.get("n_dv_bins", 5)
DV_MIN         = config.get("dv_min",   -1.0)
DV_MAX         = config.get("dv_max",   -1.0)
MAX_TIME_VALUES = [1200] #list(range(1100, 1301, 20))
N_MCMC_SAMPLES  = config.get("n_mcmc_samples", 10000)
N_MCMC_CHAINS   = config.get("n_mcmc_chains",  4)

# ── Shift-specific settings ────────────────────────────────────────────────────
SHIFT_DIRS = ["shiftLeft", "shiftRight"]


def get_shift_outputs(pattern, ignoreStripes=[], max_times=None, shift_dirs=None):
    """Generate output paths for all shift_dir × max_time × stripe × embryo combos.

    Parameters
    ----------
    pattern : str
        Path template containing any of {shift_dir}, {max_time}, {stripe}, {embryo}.
    ignoreStripes : list
        Stripe names to skip.
    max_times : list | None
        If provided, expand {max_time}; otherwise omit that dimension.
    shift_dirs : list | None
        Shift directions to expand; defaults to SHIFT_DIRS.
    """
    if shift_dirs is None:
        shift_dirs = SHIFT_DIRS
    outputs = []
    for shift_dir in shift_dirs:
        for stripe in STRIPES:
            if stripe in ignoreStripes:
                continue
            if stripe in EMBRYOS:
                for embryo in EMBRYOS[stripe]:
                    if max_times is None:
                        outputs.append(pattern.format(shift_dir=shift_dir, stripe=stripe, embryo=embryo))
                    else:
                        for mt in max_times:
                            outputs.append(pattern.format(shift_dir=shift_dir, max_time=mt, stripe=stripe, embryo=embryo))
    return outputs


