    Requires all four model chains to be complete before running.
    """
    wildcard_constraints:
        shift_dir="shiftLeft|shiftRight",
        embryo="[^/]*(?<!_null)(?<!_age)(?<!_biphasic)"
    input:
        spatial_chain="{shift_dir}/results_{max_time}/{stripe}/{embryo}/chains/degradation_chain.csv",
        null_chain="{shift_dir}/results_{max_time}/{stripe}/{embryo}_null/chains/degradation_chain.csv",
