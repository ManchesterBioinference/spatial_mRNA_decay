        get_shift_outputs("{shift_dir}/results_{max_time}/comparison/{stripe}/{embryo}/comparison_summary.txt", max_times=MAX_TIME_VALUES),
        get_shift_outputs("{shift_dir}/results_{max_time}/comparison/{stripe}/{embryo}/loo_diagnostics_summary.txt", max_times=MAX_TIME_VALUES),


# ── Stage 1: Apply shift to stripe AP ranges ──────────────────────────────────

rule apply_stripe_shift:
    """
    Translate stripe AP coordinate ranges by ±half a bin width.

    Reads the populated per-max_time config (produced by identify_stripe_ranges
    in the main Snakefile) and shifts every stripe's min/center/max by:

        shift = (max − min) / (2 × n_ap_bins)

    The shifted config is saved to {shift_dir}/results_{max_time}/config.yaml
    and a touch file signals downstream rules that the config is ready.

    This rule requires the main pipeline's stripe identification step to have
    completed (results_{max_time}/config.yaml.updated must exist).

    Shift direction is encoded in the {shift_dir} wildcard:
        shiftLeft  → direction = left  (lower AP / anterior)
        shiftRight → direction = right (higher AP / posterior)
    """
    wildcard_constraints:
        shift_dir="shiftLeft|shiftRight"
    input:
        config="results_{max_time}/config.yaml",
        config_updated="results_{max_time}/config.yaml.updated",  # main pipeline stripe detection complete
        script="scripts/apply_stripe_shift.py"
    output:
        shifted_config="{shift_dir}/results_{max_time}/config.yaml",
        config_updated=touch("{shift_dir}/results_{max_time}/config.yaml.updated")
    params:
        direction=lambda wildcards: "left" if wildcards.shift_dir == "shiftLeft" else "right",
        n_ap_bins=N_AP_BINS
    log:
        "{shift_dir}/results_{max_time}/logs/apply_stripe_shift.log"
    shell:
        """
        mkdir -p $(dirname {output.shifted_config})
        python {input.script} \
            --input-config  {input.config} \
            --output-config {output.shifted_config} \
            --direction     {params.direction} \
            --n-ap-bins     {params.n_ap_bins} \
            2>&1 | tee {log}
        """


# ── Stage 2: Recompute validation thresholds for shifted AP window ─────────────

rule compute_validation_thresholds:
    """
    Compute nuclei density validation thresholds from Berrocal_2020 data
    using the *shifted* stripe AP coordinate ranges.

    Because the AP window is different from the main pipeline, the subset of
    Berrocal nuclei falling within each stripe differs.  Thresholds must be
    recomputed to avoid false HARD GATE failures in bin_mrna_counts.

    Outputs validation_updated touch file consumed by bin_mrna_counts.
    """
    wildcard_constraints:
        shift_dir="shiftLeft|shiftRight"
    input:
        data="data/Berrocal_2020/Data/eve_data_longform_w_nuclei_060520_FILTERED.csv",
        script="scripts/06_compute_validation_thresholds.py",
        config_updated="{shift_dir}/results_{max_time}/config.yaml.updated"
    output:
        validation_updated=touch("{shift_dir}/results_{max_time}/config.yaml.validation_updated"),
        figures_dir=directory("{shift_dir}/results_{max_time}/figures/intermediate/transcription/nucleiDistributions")
    params:
        config_file=lambda wildcards: f"{wildcards.shift_dir}/results_{wildcards.max_time}/config.yaml",
        output_dir=lambda wildcards: f"{wildcards.shift_dir}/results_{wildcards.max_time}/figures/intermediate/transcription/nucleiDistributions",
        k=4,
        max_time=lambda wildcards: int(wildcards.max_time),
        n_ap_bins=N_AP_BINS,
        n_dv_bins=N_DV_BINS
    log:
        "{shift_dir}/results_{max_time}/logs/compute_validation_thresholds.log"
    shell:
        """
        python scripts/06_compute_validation_thresholds.py \
            --input     {input.data} \
            --config    {params.config_file} \
            --output-dir {params.output_dir} \
            --k         {params.k} \
            --max-time  {params.max_time} \
            --n-ap-bins {params.n_ap_bins} \
            --n-dv-bins {params.n_dv_bins} \
            2>&1 | tee {log}
        """


